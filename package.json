{
  "name": "macha-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Macha Finance — CFO-layer SaaS backend (Bun + Elysia + Drizzle + Postgres).",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --env=disable --outdir dist",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test src",
    "test:integration": "bun run tests/integration/run.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "provision:tenant": "bun run scripts/provision-tenant.ts",
    "restore:drill": "bun run scripts/restore-drill.ts",
    "audit:staging-data": "bun run scripts/audit-staging-data.ts",
    "verify:isolation": "bun run scripts/verify-isolation.ts",
    "bench:ingest": "bun run scripts/benchmark-ingest.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@sentry/bun": "^8.26.0",
    "drizzle-orm": "^0.33.0",
    "elysia": "^1.1.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.4.1",
    "jose": "^5.9.0",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.4",
    "resend": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.1.6",
    "drizzle-kit": "^0.24.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,sql}": [
      "prettier --write"
    ]
  }
}
