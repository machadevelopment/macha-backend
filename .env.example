# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- Postgres (Railway managed) ---
# Owner/admin role — used by db:migrate/db:generate/db:seed/provision:tenant. This
# role owns every table (it ran the migrations), so it always bypasses REVOKE
# UPDATE/DELETE on the append-only ledgers (Postgres table owners can't be blocked
# from their own objects' DML — there's no "FORCE" for privileges like there is for
# RLS). Never point the running app at this role directly in a real environment.
DATABASE_URL=postgres://user:pass@localhost:5432/macha
# Restricted runtime role. NOT created by any migration (that would need CREATEROLE,
# which a managed-Postgres app user often lacks) — a manual one-time step against the
# real Railway Postgres: `CREATE ROLE macha_app LOGIN NOSUPERUSER NOCREATEDB
# NOCREATEROLE NOBYPASSRLS PASSWORD '<generated>';`. Migration 0010 then grants it the
# right privileges (and re-runs safely once the role exists — see its header).
# Set this in Railway/staging/prod so the app connects as macha_app instead of the
# owner — only then does the append-only guarantee actually hold. Falls back to
# DATABASE_URL if unset (local/ephemeral dev keeps working, single-role).
APP_DATABASE_URL=

# --- Redis (Railway, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Intake de Excel (caps, CU-868kfv972 — aprobado sin cambios) ---
INTAKE_MAX_FILE_SIZE_MB=10
INTAKE_MAX_ROWS_PER_FILE=50000
INTAKE_MAX_SHEETS_PER_WORKBOOK=30
INTAKE_LARGE_SHEET_ROW_THRESHOLD=5000
INTAKE_BATCH_SIZE=2000

# --- Rate limiting (CU-868kfv97f — valores reales aprobados por Jose) ---
# Gate de cola: solo excel/report_generation (chat/insight no pasan por el gate).
RATE_LIMIT_QUEUE_GATE_MAX_JOBS=3
# Token-bucket "ai": solo chat/insight (excel/reporte se controlan por el gate).
RATE_LIMIT_AI_RPM=20
RATE_LIMIT_AI_BURST=30
# Token-bucket "read": API general de lectura (dashboard, status polling).
RATE_LIMIT_READ_RPM=120
RATE_LIMIT_READ_BURST=240
# Alta de empresas (CU-868kjc950): clave por USUARIO, porque en /register todavía no hay
# empresa. Bajo a propósito — cada llamada corre CREATE TABLE ... PARTITION OF tres veces
# contra el Postgres compartido, así que sin techo es DDL ilimitado sobre la base de
# todos los clientes. RPH = por hora.
RATE_LIMIT_REGISTER_RPH=3
RATE_LIMIT_REGISTER_BURST=3
# Top-up de créditos: bucket propio y más estricto que `ai`, porque cada llamada abre un
# checkout en el proveedor de pagos.
RATE_LIMIT_BILLING_RPM=5
RATE_LIMIT_BILLING_BURST=8

# --- Créditos (CU-868kfv97x — valores provisionales de arranque, holgados a propósito) ---
CREDIT_TO_TOKENS_RATIO=50000
CREDIT_MONTHLY_ALLOTMENT=1000

# --- WorkOS / AuthKit (JWT verified via JWKS) ---
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/xxx
WORKOS_CLIENT_ID=
# Solo para el alta JIT de una identidad nueva (CU-868kjkfdf): el access token de WorkOS
# no trae email ni nombre y `users.email` es NOT NULL, así que el perfil se le pide a la
# Management API por el `sub` que ya venía firmado — nunca al cliente. Una llamada por
# usuario en toda su vida; sin esta clave, quien ya existe entra igual.
WORKOS_API_KEY=

# --- Anthropic (ZDR contract; claude-sonnet-5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- AWS S3 (binaries; DB stores only keys) ---
S3_REGION=us-east-1
S3_BUCKET=macha-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@macha.finance

# --- Sentry ---
SENTRY_DSN=

# --- App base URL (email links, Recurrente checkout redirects) ---
APP_BASE_URL=http://localhost:3000

# --- Backups (CU-868kfvar3) — pg_dump nocturno a S3, segunda capa aparte del backup
# nativo de Railway (config de consola, no vive aquí) ---
BACKUP_RETENTION_DAYS=30

# --- Recurrente (docs.recurrente.com) — CU-868kfvae6 ---
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=

# CU-868kjbw5h: true en staging/prod DESPUES de crear el rol macha_app y verificarlo
# (ver el runbook del README). Aborta el arranque si el rol de la app no esta aislado.
REQUIRE_ISOLATED_DB_ROLE=false
